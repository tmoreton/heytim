FROGBOT_AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:ACCOUNT_ID:runtime/RUNTIME_ID
FROGBOT_AGENT_RUNTIME_QUALIFIER=DEFAULT
# Optional until Apple push credentials are provisioned. These are SNS platform
# application ARNs, not Apple private keys or device tokens.
FROGBOT_APNS_APPLICATION_ARN=arn:aws:sns:us-east-1:ACCOUNT_ID:app/APNS/FroggyBot
FROGBOT_APNS_SANDBOX_APPLICATION_ARN=arn:aws:sns:us-east-1:ACCOUNT_ID:app/APNS_SANDBOX/FroggyBot
