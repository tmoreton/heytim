{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadHeyTimUserAttachments",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::frogbot-user-files-188757775631-us-east-1/users/*",
        "arn:aws:s3:::frogbot-user-files-188757775631-us-east-1/groups/*"
      ]
    },
    {
      "Sid": "ListScopedHeyTimArtifacts",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::frogbot-user-files-188757775631-us-east-1",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "users/*/artifacts/*",
            "users/*/bots/*/artifacts/*",
            "groups/*/artifacts/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadHeyTimMemeTemplates",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::frogbot-user-files-188757775631-us-east-1/meme-templates/*"
    },
    {
      "Sid": "UseHeyTimUserFilesEncryptionKey",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:GenerateDataKey"
      ],
      "Resource": "arn:aws:kms:us-east-1:188757775631:key/c7a32163-5c7e-459d-a833-4fbd686bb57c"
    },
    {
      "Sid": "ReadHeyTimConnectionCredentials",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": [
        "arn:aws:secretsmanager:us-east-1:188757775631:secret:heytim/connections/*",
        "arn:aws:secretsmanager:us-east-1:188757775631:secret:frogbot/connections/*",
        "arn:aws:secretsmanager:us-east-1:188757775631:secret:heytim/oauth/google-*",
        "arn:aws:secretsmanager:us-east-1:188757775631:secret:frogbot/oauth/google-*",
        "arn:aws:secretsmanager:us-east-1:188757775631:secret:heytim/oauth/github-*",
        "arn:aws:secretsmanager:us-east-1:188757775631:secret:frogbot/oauth/github-*",
        "arn:aws:secretsmanager:us-east-1:188757775631:secret:heytim/oauth/x-*",
        "arn:aws:secretsmanager:us-east-1:188757775631:secret:frogbot/oauth/x-*",
        "arn:aws:secretsmanager:us-east-1:188757775631:secret:heytim/oauth/slack-*",
        "arn:aws:secretsmanager:us-east-1:188757775631:secret:frogbot/oauth/slack-*",
        "arn:aws:secretsmanager:us-east-1:188757775631:secret:heytim/oauth/microsoft-*",
        "arn:aws:secretsmanager:us-east-1:188757775631:secret:frogbot/oauth/microsoft-*",
        "arn:aws:secretsmanager:us-east-1:188757775631:secret:heytim/oauth/notion-*",
        "arn:aws:secretsmanager:us-east-1:188757775631:secret:frogbot/oauth/notion-*",
        "arn:aws:secretsmanager:us-east-1:188757775631:secret:heytim/oauth/hubspot-*",
        "arn:aws:secretsmanager:us-east-1:188757775631:secret:frogbot/oauth/hubspot-*",
        "arn:aws:secretsmanager:us-east-1:188757775631:secret:heytim/oauth/jira-*",
        "arn:aws:secretsmanager:us-east-1:188757775631:secret:frogbot/oauth/jira-*",
        "arn:aws:secretsmanager:us-east-1:188757775631:secret:heytim/oauth/zoom-*",
        "arn:aws:secretsmanager:us-east-1:188757775631:secret:frogbot/oauth/zoom-*"
      ]
    },
    {
      "Sid": "RotateHeyTimUserOAuthTokens",
      "Effect": "Allow",
      "Action": "secretsmanager:PutSecretValue",
      "Resource": [
        "arn:aws:secretsmanager:us-east-1:188757775631:secret:heytim/connections/*",
        "arn:aws:secretsmanager:us-east-1:188757775631:secret:frogbot/connections/*"
      ]
    }
  ]
}
