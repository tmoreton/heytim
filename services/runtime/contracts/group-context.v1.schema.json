{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heytim.ai/contracts/group-context.v1.schema.json",
  "title": "HeyTim group runtime context v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "memory", "people", "bots", "decisions", "round"],
  "properties": {
    "schemaVersion": {"const": 1},
    "name": {"type": "string", "minLength": 1, "maxLength": 64},
    "memory": {"type": "string", "maxLength": 4000},
    "people": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 40},
          "role": {"enum": ["owner", "member"]}
        }
      }
    },
    "bots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "tagline", "isCurrent"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 64},
          "name": {"type": "string", "minLength": 1, "maxLength": 60},
          "tagline": {"type": "string", "maxLength": 120},
          "isCurrent": {"type": "boolean"}
        }
      }
    },
    "decisions": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "sourceAuthorName", "createdByName", "createdAt"],
        "properties": {
          "text": {"type": "string", "minLength": 1, "maxLength": 1000},
          "sourceAuthorName": {"type": "string", "minLength": 1, "maxLength": 60},
          "createdByName": {"type": "string", "minLength": 1, "maxLength": 40},
          "createdAt": {"type": "string", "maxLength": 32}
        }
      }
    },
    "round": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "size", "role", "coordinatorName"],
      "properties": {
        "position": {"type": "integer", "minimum": 1, "maximum": 13},
        "size": {"type": "integer", "minimum": 1, "maximum": 13},
        "role": {"enum": ["solo", "lead", "contributor", "synthesizer"]},
        "coordinatorName": {"type": "string", "minLength": 1, "maxLength": 60}
      }
    }
  }
}
