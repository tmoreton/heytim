HEYTIM_AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:ACCOUNT_ID:runtime/RUNTIME_ID
HEYTIM_AGENT_RUNTIME_QUALIFIER=DEFAULT
# Production requires the first ARN. Local sandboxes automatically use same-account
# SNS platform applications named HeyTim; set these to override that convention.
# These are application ARNs, not Apple private keys or device tokens.
HEYTIM_APNS_APPLICATION_ARN=arn:aws:sns:us-east-1:ACCOUNT_ID:app/APNS/HeyTim
HEYTIM_APNS_SANDBOX_APPLICATION_ARN=arn:aws:sns:us-east-1:ACCOUNT_ID:app/APNS_SANDBOX/HeyTim
