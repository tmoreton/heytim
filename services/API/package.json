{
  "name": "@heytim/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "contract:generate": "node scripts/generate-api-contract.mjs && node scripts/generate-platform-contract.mjs",
    "contract:check": "node scripts/generate-api-contract.mjs --check && node scripts/generate-platform-contract.mjs --check",
    "outputs:apple": "node scripts/sync-apple-outputs.mjs",
    "outputs:apple:check": "node scripts/sync-apple-outputs.mjs --check",
    "outputs:apple:production:check": "node scripts/sync-apple-outputs.mjs --check --require-production",
    "typecheck": "tsc --noEmit",
    "test": "PYTHONPATH=amplify/functions uv run --project ../runtime --frozen python -m unittest discover -s amplify/functions/tests -p 'test_*.py'",
    "test:plaid-webhook": "node scripts/test-plaid-webhook.mjs",
    "test:bot-email-capture": "node --import tsx --test scripts/test-bot-email-capture.mjs",
    "test:release-consent-policy": "node --import tsx --test scripts/test-release-consent-policy.mjs",
    "test:bootstrap-release": "node --test scripts/test-bootstrap-release-contract.mjs",
    "verify": "npm run contract:check && npm run outputs:apple:check && npm --prefix ../../packages/heytim-contract test && npm run typecheck && npm run test:plaid-webhook && npm run test:bot-email-capture && npm run test:release-consent-policy && npm run test:bootstrap-release && npm test",
    "load:test": "node scripts/authenticated-load-test.mjs",
    "workflow:test": "node scripts/authenticated-workflow-test.mjs",
    "sandbox": "ampx sandbox --outputs-out-dir ."
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.25.1",
    "@aws-amplify/backend-cli": "^1.10.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.4",
    "aws-cdk-lib": "^2.272.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1126.0",
    "@aws-sdk/client-sqs": "^3.1126.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1126.0",
    "@aws-sdk/client-dynamodb": "^3.1126.0",
    "@aws-sdk/lib-dynamodb": "^3.1126.0"
  },
  "overrides": {
    "csv-parse": "7.0.2",
    "@graphql-codegen/plugin-helpers": {
      "lodash": "4.18.1"
    },
    "@graphql-codegen/visitor-plugin-common": {
      "lodash": "4.18.1"
    },
    "@graphql-tools/relay-operation-optimizer": "7.1.9",
    "@aws-amplify/graphql-schema-generator": {
      "mysql2": "3.24.3"
    }
  }
}
