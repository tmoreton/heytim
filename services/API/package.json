{
  "name": "@froggybot/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "contract:generate": "node scripts/generate-api-contract.mjs",
    "contract:check": "node scripts/generate-api-contract.mjs --check",
    "outputs:apple": "node scripts/sync-apple-outputs.mjs",
    "outputs:apple:check": "node scripts/sync-apple-outputs.mjs --check",
    "outputs:apple:production:check": "node scripts/sync-apple-outputs.mjs --check --require-production",
    "typecheck": "tsc --noEmit",
    "test": "PYTHONPATH=amplify/functions uv run --project ../runtime --frozen python -m unittest discover -s amplify/functions/tests -p 'test_*.py'",
    "verify": "npm run contract:check && npm run outputs:apple:check && npm --prefix ../../packages/froggybot-contract test && npm run typecheck && npm test",
    "load:test": "node scripts/authenticated-load-test.mjs",
    "workflow:test": "node scripts/authenticated-workflow-test.mjs",
    "sandbox": "ampx sandbox --outputs-out-dir ."
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.25.0",
    "@aws-amplify/backend-cli": "^1.10.0",
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^26.5.1",
    "aws-cdk-lib": "^2.268.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1126.0",
    "@aws-sdk/client-dynamodb": "^3.1126.0",
    "@aws-sdk/lib-dynamodb": "^3.1126.0"
  },
  "overrides": {
    "@graphql-codegen/plugin-helpers": {
      "lodash": "4.18.1"
    },
    "@graphql-codegen/visitor-plugin-common": {
      "lodash": "4.18.1"
    },
    "@graphql-tools/relay-operation-optimizer": "7.1.9",
    "@aws-amplify/graphql-schema-generator": {
      "mysql2": "3.24.3"
    }
  }
}
