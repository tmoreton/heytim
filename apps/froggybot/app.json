{
  "expo": {
    "name": "FroggyBot",
    "slug": "frogbot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/frogbot-icon.png",
    "scheme": "frogbot",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.frogbot.app",
      "appleTeamId": "GVXC5FQ2RP",
      "associatedDomains": [
        "applinks:froggybot.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Allow FroggyBot to select photos you choose to share in a conversation."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F2EC",
        "foregroundImage": "./assets/images/frogbot-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/frogbot-favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Content-Security-Policy": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.amazonaws.com https://*.amazoncognito.com https://*.expo.dev wss://*.amazonaws.com; frame-src https:; worker-src 'self' blob:; form-action 'self'",
            "Permissions-Policy": "camera=(), geolocation=(), payment=(), usb=()",
            "Referrer-Policy": "strict-origin-when-cross-origin",
            "X-Content-Type-Options": "nosniff",
            "X-Frame-Options": "DENY"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F2EC",
          "image": "./assets/images/frogbot-foreground.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#007A3D",
          "defaultChannel": "agent-replies"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow FroggyBot to hear you while you dictate a message.",
          "speechRecognitionPermission": "Allow FroggyBot to turn your speech into text on this device."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "040c2a82-3c96-494a-aec0-1084b05e6d1a"
      }
    },
    "owner": "reactnativenerd",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/040c2a82-3c96-494a-aec0-1084b05e6d1a"
    }
  }
}
