{
  "name": "frogbot",
  "description": "Deprecated native Expo client retained as FroggyBot's browser client and migration reference.",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@aws-amplify/react-native": "^1.3.3",
    "@froggybot/client": "file:../../packages/froggybot-client",
    "@froggybot/contracts": "file:../../packages/froggybot-contract",
    "@froggybot/expo-client": "file:../../packages/froggybot-expo-client",
    "@froggybot/preview": "file:../../packages/froggybot-preview",
    "@froggybot/transcription": "file:../../packages/frogbot-transcription",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "aws-amplify": "^6.20.0",
    "expo": "~57.0.22",
    "expo-asset": "~57.0.16",
    "expo-build-properties": "~57.0.17",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.17",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "~57.0.17",
    "expo-image-picker": "~57.0.17",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.18",
    "expo-router": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.22",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-get-random-values": "~1.11.0",
    "react-native-markdown-renderer": "^4.1.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "query-string": {
      "decode-uri-component": "0.5.0"
    },
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "scripts": {
    "browser:build": "npm --prefix ../froggybot-browser-viewer run build && node scripts/sync-browser-viewer.mjs",
    "start": "npm run browser:build && expo start",
    "start:preview": "npm run browser:build && FROGBOT_ENABLE_LOCAL_PREVIEW=1 expo start",
    "ios": "../../scripts/apple-app.sh run ios",
    "ios:build": "../../scripts/apple-app.sh build ios",
    "ios:mac": "../../scripts/apple-app.sh run macos",
    "ios:mac:build": "../../scripts/apple-app.sh build macos",
    "legacy:android": "expo start --android",
    "legacy:android:preview": "FROGBOT_ENABLE_LOCAL_PREVIEW=1 expo start --android",
    "legacy:ios": "expo start --ios",
    "legacy:ios:preview": "FROGBOT_ENABLE_LOCAL_PREVIEW=1 expo start --ios",
    "legacy:ios:native": "npm run nemotron:prepare:ios && expo run:ios",
    "legacy:ios:mac": "./scripts/run-ios-on-mac.sh",
    "nemotron:prepare:ios": "./scripts/prepare-nemotron-apple.sh ios",
    "nemotron:prepare:apple": "./scripts/prepare-nemotron-apple.sh apple",
    "nemotron:smoke:macos": "npm run nemotron:prepare:apple && swift run --package-path ../../packages/frogbot-transcription frogbot-nemotron-smoke",
    "eas-build-pre-install": "node scripts/reject-deprecated-native-build.mjs",
    "web": "npm run browser:build && expo start --web",
    "web:preview": "npm run browser:build && FROGBOT_ENABLE_LOCAL_PREVIEW=1 EXPO_NO_METRO_LAZY=1 expo start --web",
    "build:web": "npm run browser:build && expo export --platform web && npm run preview:check && npm run bundle:size && npm run web:headers",
    "preview:check": "node scripts/check-preview-boundary.mjs",
    "view:boundary": "node scripts/check-view-boundary.mjs",
    "bundle:size": "node scripts/check-web-bundle-size.mjs",
    "web:headers": "node scripts/check-web-headers.mjs",
    "deploy:web": "../../scripts/assert-release-ready.sh && npm run build:web && eas deploy --prod --non-interactive",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test 'src/**/*.test.mjs'",
    "source:size": "../../scripts/check-source-size.sh",
    "verify": "npm run source:size && npm run view:boundary && npm test && npm run typecheck && npm run lint && npx expo-doctor"
  },
  "engines": {
    "node": ">=22.13 <25"
  },
  "private": true
}
