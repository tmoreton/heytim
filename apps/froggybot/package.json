{
  "name": "frogbot",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@aws-amplify/react-native": "^1.3.3",
    "@babel/runtime": "7.29.7",
    "@cloudscape-design/components": "3.0.1368",
    "@cloudscape-design/design-tokens": "3.0.112",
    "@cloudscape-design/global-styles": "1.0.68",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "aws-amplify": "^6.20.0",
    "bedrock-agentcore": "0.4.3",
    "expo": "~57.0.22",
    "expo-asset": "~57.0.16",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.17",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.18",
    "expo-router": "~57.0.21",
    "expo-speech-recognition": "^57.0.0",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.22",
    "prop-types": "15.8.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-get-random-values": "~1.11.0",
    "react-native-markdown-renderer": "^4.1.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "query-string": {
      "decode-uri-component": "0.5.0"
    },
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "scripts": {
    "browser:build": "node src/features/browser/viewer/build.mjs",
    "start": "npm run browser:build && expo start",
    "postinstall": "patch-package",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "npm run browser:build && expo start --web",
    "build:web": "npm run browser:build && expo export --platform web && npm run bundle:size && npm run web:headers",
    "bundle:size": "node scripts/check-web-bundle-size.mjs",
    "web:headers": "node scripts/check-web-headers.mjs",
    "deploy:web": "../../scripts/assert-release-ready.sh && npm run build:web && eas deploy --prod --non-interactive",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test 'src/**/*.test.mjs'",
    "source:size": "../../scripts/check-source-size.sh",
    "backend:install": "npm install --prefix amplify",
    "backend:typecheck": "./amplify/node_modules/.bin/tsc -p amplify/tsconfig.json --noEmit",
    "backend:test": "PYTHONPATH=amplify/functions uv run --project ../../services/agent-runtime --frozen python -m unittest discover -s amplify/functions/tests -p 'test_*.py'",
    "load:test": "node scripts/authenticated-load-test.mjs",
    "workflow:test": "node scripts/authenticated-workflow-test.mjs",
    "verify": "npm run source:size && npm test && npm run typecheck && npm run lint && npm run backend:typecheck && npm run backend:test && npx expo-doctor",
    "sandbox": "./amplify/node_modules/.bin/ampx sandbox"
  },
  "engines": {
    "node": ">=22.13 <25"
  },
  "private": true
}
