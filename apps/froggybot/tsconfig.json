{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "preserveSymlinks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@froggybot/preview-api": [
        "./src/lib/preview/preview-api.disabled"
      ],
      "@froggybot/contracts": [
        "../../packages/froggybot-contract/src/index"
      ],
      "@froggybot/client": [
        "../../packages/froggybot-client/src/index"
      ],
      "@froggybot/transcription": [
        "../../packages/frogbot-transcription/index"
      ],
      "@froggybot/preview": [
        "../../packages/froggybot-preview/src/index"
      ],
      "expo": [
        "./node_modules/expo"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../packages/froggybot-preview/**/*.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": ["amplify"]
}
