{
  "cli": {
    "version": ">= 23.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "archived-development": {
      "node": "22.23.2",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "legacy-frozen"
    },
    "archived-preview": {
      "node": "22.23.2",
      "distribution": "internal",
      "channel": "legacy-frozen"
    },
    "archived-preview-simulator": {
      "extends": "archived-preview",
      "ios": {
        "simulator": true
      },
      "channel": "legacy-frozen"
    },
    "archived-production": {
      "node": "22.23.2",
      "autoIncrement": true,
      "channel": "legacy-frozen"
    }
  }
}
