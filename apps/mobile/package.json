{
  "name": "frogbot",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@aws-amplify/react-native": "^1.3.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "aws-amplify": "^6.20.0",
    "expo": "~57.0.20",
    "expo-constants": "~57.0.17",
    "expo-device": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.19",
    "expo-speech-recognition": "^57.0.0",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-get-random-values": "~1.11.0",
    "react-native-markdown-renderer": "^4.1.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "postinstall": "patch-package",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "deploy:web": "npm run build:web && eas deploy --prod --non-interactive",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "backend:install": "npm install --prefix amplify",
    "backend:typecheck": "./amplify/node_modules/.bin/tsc -p amplify/tsconfig.json --noEmit",
    "backend:test": "PYTHONPATH=amplify/functions python3 -m unittest discover -s amplify/functions/tests -p 'test_*.py'",
    "verify": "npm run typecheck && npm run lint && npm run backend:typecheck && npm run backend:test && npx expo-doctor",
    "sandbox": "./amplify/node_modules/.bin/ampx sandbox"
  },
  "engines": {
    "node": ">=22.13 <25"
  },
  "private": true
}
