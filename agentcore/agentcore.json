{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "FrogBot",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "FrogBot"
  },
  "runtimes": [
    {
      "name": "FrogBot",
      "description": "Stan-powered multi-personality chat runtime for the FrogBot mobile app",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/FrogBot/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "authorizerType": "AWS_IAM",
      "lifecycleConfiguration": {
        "idleRuntimeSessionTimeout": 900,
        "maxLifetime": 7200
      }
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "FrogBotTools",
      "protocolType": "MCP",
      "description": "Read-only research tools available to FrogBot agents",
      "targets": [
        {
          "name": "FrogBotWebSearch",
          "targetType": "connector",
          "connectorId": "web-search"
        }
      ],
      "authorizerType": "AWS_IAM",
      "enableSemanticSearch": true,
      "exceptionLevel": "NONE"
    }
  ],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "payments": []
}
