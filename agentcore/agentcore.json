{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "FrogBot",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "FrogBot"
  },
  "runtimes": [
    {
      "name": "FrogBot",
      "description": "Stan-powered multi-personality chat runtime for the HeyTim app",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "services/runtime/runtime/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "authorizerType": "AWS_IAM",
      "instrumentation": {
        "enableOtel": true
      },
      "envVars": [
        {
          "name": "HEYTIM_FILES_BUCKET",
          "value": "frogbot-user-files-188757775631-us-east-1"
        },
        {
          "name": "HEYTIM_POINTS_SCREENSHOT_DOMAINS",
          "value": "aa.com,aeroplan.com,aircanada.com,airfrance.com,alaskaair.com,all.accor.com,britishairways.com,choicehotels.com,delta.com,emirates.com,flyingblue.com,hilton.com,hyatt.com,ihg.com,jetblue.com,klm.com,marriott.com,qantas.com,qatarairways.com,singaporeair.com,southwest.com,united.com,virginatlantic.com,wyndhamhotels.com"
        },
        {
          "name": "HEYTIM_MEME_TEMPLATE_PREFIX",
          "value": "meme-templates/v1"
        },
        {
          "name": "HEYTIM_IMAGE_MODEL_ID",
          "value": "openai/gpt-image-2.5-sunburst"
        },
        {
          "name": "HEYTIM_IMAGE_QUALITY",
          "value": "high"
        },
        {
          "name": "HEYTIM_IMAGE_REQUEST_TIMEOUT_SECONDS",
          "value": "300"
        },
        {
          "name": "HEYTIM_IMAGE_MAX_ATTEMPTS",
          "value": "2"
        },
        {
          "name": "HEYTIM_PRIMARY_MODEL_ID",
          "value": "deepseek/deepseek-v4.1-flash"
        },
        {
          "name": "HEYTIM_REASONING_EFFORT",
          "value": "high"
        },
        {
          "name": "HEYTIM_FALLBACK_MODEL_ID",
          "value": "z-ai/glm-5.3"
        },
        {
          "name": "HEYTIM_FALLBACK_REASONING_EFFORT",
          "value": "high"
        },
        {
          "name": "HEYTIM_OPENROUTER_BASE_URL",
          "value": "https://openrouter.ai/api/v1"
        },
        {
          "name": "HEYTIM_OPENROUTER_CREDENTIAL_PROVIDER",
          "value": "FrogBot_OpenRouter"
        },
        {
          "name": "HEYTIM_PRIMARY_RESPONSE_TIMEOUT_SECONDS",
          "value": "120"
        },
        {
          "name": "HEYTIM_OPENROUTER_MAX_ATTEMPTS",
          "value": "2"
        },
        {
          "name": "HEYTIM_CONTEXT_COMPRESSION_THRESHOLD",
          "value": "0.20"
        },
        {
          "name": "HEYTIM_AGENT_RUN_TIMEOUT_SECONDS",
          "value": "28800"
        },
        {
          "name": "HEYTIM_AGENT_IDLE_TIMEOUT_SECONDS",
          "value": "360"
        },
        {
          "name": "OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT",
          "value": "NO_CONTENT"
        },
        {
          "name": "OTEL_SEMCONV_STABILITY_OPT_IN",
          "value": "gen_ai_unredacted_attributes="
        }
      ],
      "additionalPolicies": [
        "attachments-policy.json"
      ],
      "lifecycleConfiguration": {
        "idleRuntimeSessionTimeout": 900,
        "maxLifetime": 28800
      },
      "connections": [
        {
          "id": "codeInterpreter",
          "to": {
            "type": "codeInterpreter"
          }
        },
        {
          "id": "browser",
          "to": {
            "type": "browser"
          }
        }
      ]
    }
  ],
  "memories": [
    {
      "name": "FrogBotMemory",
      "eventExpiryDuration": 30,
      "encryptionKeyArn": "arn:aws:kms:us-east-1:188757775631:key/e9929d3a-9dec-4f34-8c83-dd0586cb0ef8",
      "strategies": [
        {
          "type": "SEMANTIC",
          "name": "FrogBotFacts",
          "namespaceTemplates": [
            "/facts/{actorId}/"
          ]
        },
        {
          "type": "SUMMARIZATION",
          "name": "FrogBotSummaries",
          "namespaceTemplates": [
            "/summaries/{actorId}/{sessionId}/"
          ]
        },
        {
          "type": "USER_PREFERENCE",
          "name": "FrogBotPreferences",
          "namespaceTemplates": [
            "/preferences/{actorId}/"
          ]
        }
      ]
    }
  ],
  "knowledgeBases": [],
  "credentials": [
    {
      "authorizerType": "ApiKeyCredentialProvider",
      "name": "FrogBot_OpenRouter"
    },
    {
      "authorizerType": "ApiKeyCredentialProvider",
      "name": "FrogBotXApi"
    },
    {
      "authorizerType": "ApiKeyCredentialProvider",
      "name": "FrogBotYouTubeApi"
    }
  ],
  "evaluators": [
    {
      "name": "FrogBotRunIntegrity",
      "level": "SESSION",
      "description": "Deterministically detects terminal failures without capturing conversation content",
      "config": {
        "codeBased": {
          "managed": {
            "codeLocation": "evaluators/heytim_run_integrity",
            "entrypoint": "lambda_function.handler",
            "timeoutSeconds": 30
          }
        }
      }
    }
  ],
  "onlineEvalConfigs": [
    {
      "name": "FrogBotContinuousQuality",
      "agent": "FrogBot",
      "evaluators": [
        "FrogBotRunIntegrity"
      ],
      "samplingRate": 5,
      "description": "Samples deployed sessions for structural completion failures",
      "enableOnCreate": true
    }
  ],
  "agentCoreGateways": [
    {
      "name": "FrogBotTools",
      "protocolType": "MCP",
      "description": "Read-only research tools available to HeyTim agents",
      "targets": [
        {
          "name": "FrogBotWebSearch",
          "targetType": "connector",
          "connectorId": "web-search"
        }
      ],
      "authorizerType": "AWS_IAM",
      "enableSemanticSearch": true,
      "exceptionLevel": "NONE"
    }
  ],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [
    {
      "name": "FrogBotRegression",
      "schemaType": "AGENTCORE_EVALUATION_PREDEFINED_V1",
      "description": "Critical behavior checks for research, browser, image, bot management, and failover",
      "config": {
        "managed": {
          "location": "datasets/HeyTimRegression.jsonl"
        }
      }
    }
  ],
  "payments": []
}
