# EAS uploads the repository root so workspace packages remain available.
# Exclude infrastructure, backend code, and local build output from iOS builds.
/.git/
/.github/
/.DS_Store
/.pytest_cache/
/.ruff_cache/
/agentcore/
/docs/
/evaluators/
/examples/
/output/
/scripts/
/services/
/apps/froggybot-browser-viewer/

# Expo app dependencies and generated output are restored during the build.
/apps/froggybot/node_modules/
/apps/froggybot/.amplify/
/apps/froggybot/.claude/
/apps/froggybot/.expo/
/apps/froggybot/.pytest_cache/
/apps/froggybot/.ruff_cache/
/apps/froggybot/.vscode/
/apps/froggybot/dist/
/apps/froggybot/ios/
/apps/froggybot/android/
/apps/froggybot/expo-env.d.ts
/apps/froggybot/*.tsbuildinfo
/apps/froggybot/*.orig.*

# Workspace package caches and generated native resources are reproducibly
# restored by apps/froggybot/scripts/prepare-nemotron-apple.sh.
/packages/*/node_modules/
/packages/*/dist/
/packages/frogbot-transcription/.build/
/packages/frogbot-transcription/ios/Generated/

# Local credentials and logs must never enter the build archive.
**/.env*.local
**/*.jks
**/*.p8
**/*.p12
**/*.key
**/*.mobileprovision
**/*.pem
**/npm-debug.*
**/yarn-debug.*
**/yarn-error.*
